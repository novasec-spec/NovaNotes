{
  "expo": {
    "name": "NovaNote",
    "slug": "novasec",
    "version": "1.0.0",
    "sdkVersion": "54.0.0",
    "updates": {
      "url": "https://u.expo.dev/c39ab55b-00b0-4e0c-ba80-9df316f2a3b7"
    },
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "novanote",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "jsEngine": "jsc",
      "bundleIdentifier": "com.novasec.notes"
      },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "jsEngine": "jsc",
      "googleServicesFile": "./google-services.json",
      "package": "com.novasec.notes",
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": true,
      "permissions": [
        "android.permission.INTERNET",
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE",
        " SCHEDULE_EXACT_ALARM",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-notifications",
      "@react-native-community/datetimepicker",
      "expo-secure-store",
      "expo-web-browser",
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              // This "name" must match the key in nameToWidget
              // inside widget-task-handler.tsx
              "name": "Bubbles",

              // Label shown when Alice long-presses home screen → Widgets
              "label": "Bubbles — Quote & Mood",

              "description": "Daily quote, mood, streak & love note",

              // Size on home screen grid
              "minWidth": "250dp",
              "minHeight": "110dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,

              // Allow Alice to resize it
              "resizeMode": "horizontal|vertical",
              "minResizeWidth": "180dp",
              "minResizeHeight": "100dp",
              "maxResizeWidth": "400dp",
              "maxResizeHeight": "250dp",

              // How often Android force-refreshes it on its own
              // (30 min minimum — your app can refresh more often via
              // requestWidgetUpdate when she opens it)
              "updatePeriodMillis": 1800000,

              // Screenshot shown in the widget picker — create this!
              // Take a screenshot of the widget once it's working,
              // crop it, save it here:
              "previewImage": "./assets/widget-preview/bubbles.png"
            }
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "c39ab55b-00b0-4e0c-ba80-9df316f2a3b7"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    }
  }
}
