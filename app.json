{
  "expo": {
    "name": "NovaNote",
    "slug": "novasec",
    "version": "1.0.0",
    "sdkVersion": "54.0.0",
    "updates": {
      "url": "https://u.expo.dev/c39ab55b-00b0-4e0c-ba80-9df316f2a3b7"
    },
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "novanote",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "jsEngine": "jsc",
      "bundleIdentifier": "com.novasec.notes",
      "infoPlist": {
        "UIBackgroundModes": [
          "audio"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "jsEngine": "jsc",
      "googleServicesFile": "./google-services.json",
      "enableBackgroundAudio": true,
      "package": "com.novasec.notes",
      "edgeToEdgeEnabled": true,
      "softwareKeyboardLayoutMode": "resize",
      "predictiveBackGestureEnabled": true,
      "permissions": [
        "android.permission.INTERNET",
        "RECEIVE_BOOT_COMPLETED",
        "NOTIFICATIONS",
        "VIBRATE",
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "notification": {
      "icon": "./assets/images/notification-icon.png",
      "color": "#FF6B9D",
      "androidMode": "default",
      "androidCollapsedTitle": "New Update"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#FF6B9D"
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-secure-store",
      "expo-web-browser",
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "Bubbles",
              "label": "Bubbles — Quote & Mood",
              "description": "Daily quote, mood, streak & love note",
              "minWidth": "250dp",
              "minHeight": "110dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "minResizeWidth": "180dp",
              "minResizeHeight": "100dp",
              "maxResizeWidth": "400dp",
              "maxResizeHeight": "250dp",
              "updatePeriodMillis": 1800000,
              "previewImage": "./assets/widget-preview/bubbles.png"
            }
          ]
        }
      ],

      "expo-audio",
      ["@sentry/react-native/expo", {
        "url": "https://sentry.io/",
        "project": "novasec",
        "organization": "novasec-z3"
      }]

    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "c39ab55b-00b0-4e0c-ba80-9df316f2a3b7"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    }
  }
}
