import React, { useState, useEffect } from 'react';
import {
  View,
  Text,
  TouchableOpacity,
  StyleSheet,
  Alert,
  ActivityIndicator,
  ScrollView
} from 'react-native';
import { saveMood, getTodayMood, getCurrentStreak, getDailyQuote, MOODS, getAllWidgetData } from '../widget/dataManager';
import { updateWidget, getWidgetData } from '../widget/widgetSync';
import { getAllWidgetDataDebug,  refreshWidget } from '../widget/widgetSync';

export default function HomeScreen() {
  const [currentMood, setCurrentMood] = useState(null);
  const [streak, setStreak] = useState(0);
  const [dailyQuote, setDailyQuote] = useState('');
  const [loading, setLoading] = useState(false);
  const [widgetStatus, setWidgetStatus] = useState('checking');

  useEffect(() => {
    loadData();
  }, []);

  const loadData = async () => {
    setLoading(true);
    try {
      const [mood, streakCount, quote] = await Promise.all([
        getTodayMood(),
        getCurrentStreak(),
        getDailyQuote()
      ]);
      
      setCurrentMood(mood);
      setStreak(streakCount);
      setDailyQuote(quote);
      
      // Check widget status
      const widgetData = getWidgetData();
      setWidgetStatus(widgetData ? 'active' : 'inactive');
    } catch (error) {
      console.error('Error loading data:', error);
    } finally {
      setLoading(false);
    }
  };



const testWidgetCommunication = async () => {
  console.log("🧪 TESTING WIDGET COMMUNICATION");

  // 1. Write test data
  console.log("1. Writing test data...");
  await updateWidget();

  // 2. Read back what we wrote
  console.log("2. Reading back data...");
  const data = getAllWidgetDataDebug();
  console.log("Data in shared storage:", data);

  // 3. Force refresh
  console.log("3. Forcing widget refresh...");
  refreshWidget();

  Alert.alert(
    "Widget Test",
    `Data in widget storage:\n` +
    `Mood: ${data?.mood || '❌ No mood'}\n` +
    `Quote: ${data?.quote?.substring(0, 30) || '❌ No quote'}\n` +
    `Check console for details`
  );
};


  const handleMoodSelect = async (moodKey, moodData) => {
    setLoading(true);
    try {
      // Save mood
      const success = await saveMood(moodData.name, moodData.emoji);
      
      if (success) {
        // Update widget
        await updateWidget();
        
        // Reload data
        await loadData();
        
        Alert.alert(
          'Mood Saved! 🎉',
          `Your mood: ${moodData.name} ${moodData.emoji}\nWidget updated on home screen!`,
          [{ text: 'OK', onPress: () => console.log('OK Pressed') }]
        );
      } else {
        Alert.alert('Error', 'Failed to save mood. Please try again.');
      }
    } catch (error) {
      console.error('Error in handleMoodSelect:', error);
      Alert.alert('Error', 'Something went wrong. Please try again.');
    } finally {
      setLoading(false);
    }
  };

  const handleRefreshWidget = async () => {
    setLoading(true);
    try {
      await updateWidget();
      Alert.alert('Success', 'Widget refreshed! Check your home screen.');
    } catch (error) {
      Alert.alert('Error', 'Failed to refresh widget');
    } finally {
      setLoading(false);
    }
  };

  if (loading && !currentMood) {
    return (
      <View style={styles.centerContainer}>
        <ActivityIndicator size="large" color="#FF6B6B" />
        <Text style={styles.loadingText}>Loading your mood tracker...</Text>
      </View>
    );
  }

  return (
    <ScrollView style={styles.container} showsVerticalScrollIndicator={false}>
      {/* Quote Section */}
      <View style={styles.quoteCard}>
        <Text style={styles.quoteEmoji}>💝</Text>
        <Text style={styles.quoteText}>{dailyQuote}</Text>
      </View>

      {/* Streak Section */}
      <View style={styles.streakCard}>
        <Text style={styles.streakEmoji}>🔥</Text>
        <Text style={styles.streakText}>{streak} day{streak !== 1 ? 's' : ''} in a row!</Text>
      </View>

      {/* Current Mood */}
      {currentMood && currentMood.isSet && (
        <View style={styles.currentMoodCard}>
          <Text style={styles.currentMoodLabel}>Today's Mood</Text>
          <Text style={styles.currentMoodValue}>
            {currentMood.emoji} {currentMood.mood}
          </Text>
        </View>
      )}

      {/* Mood Selection */}
      <Text style={styles.sectionTitle}>How are you feeling today?</Text>
      
      <View style={styles.moodGrid}>
        {Object.entries(MOODS).map(([key, mood]) => (
          <TouchableOpacity
            key={key}
            style={[styles.moodButton, { backgroundColor: mood.color }]}
            onPress={() => handleMoodSelect(key, mood)}
            disabled={loading}
          >
            <Text style={styles.moodEmoji}>{mood.emoji}</Text>
            <Text style={styles.moodName}>{mood.name}</Text>
          </TouchableOpacity>
        ))}
      </View>

      {/* Widget Status */}
      <View style={styles.widgetStatusCard}>
        <Text style={styles.widgetStatusTitle}>📱 Home Screen Widget</Text>
        <Text style={styles.widgetStatusText}>
          {widgetStatus === 'active' 
            ? '✅ Widget is active on your home screen' 
            : '⚠️ Add widget: Long press home screen → Widgets → Your App'}
        </Text>
        <TouchableOpacity 
          style={styles.refreshButton}
          onPress={handleRefreshWidget}
          disabled={loading}
        >
          <Text style={styles.refreshButtonText}>
            {loading ? 'Updating...' : 'Refresh Widget Now'}
          </Text>
        </TouchableOpacity>
      </View>

// Add a test button in your JSX (add this after your refresh button)
<TouchableOpacity
  style={[styles.refreshButton, { backgroundColor: '#FF6B6B', marginTop: 10 }]}
  onPress={testWidgetCommunication}
  disabled={loading}
>
  <Text style={styles.refreshButtonText}>🧪 Test Widget Communication</Text>
</TouchableOpacity>

      {/* Tips */}
      <View style={styles.tipsCard}>
        <Text style={styles.tipsTitle}>💡 Tips</Text>
        <Text style={styles.tipsText}>• Check your mood daily to build your streak!</Text>
        <Text style={styles.tipsText}>• The widget updates automatically when you save your mood</Text>
        <Text style={styles.tipsText}>• Long press home screen to add or resize the widget</Text>
      </View>
    </ScrollView>
  );
}

