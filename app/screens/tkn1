
// screens/RemoteNotificationSender.tsx
import React, { useState, useEffect } from 'react';
import { 
  View, Text, TextInput, TouchableOpacity, StyleSheet, 
  ScrollView, Alert, Switch, Modal, FlatList 
} from 'react-native';
import * as Notifications from 'expo-notifications';
import { NotificationService, NotificationAction } from '../../services/notificationService';
import Icon from 'react-native-vector-icons/Ionicons';
import AsyncStorage from '@react-native-async-storage/async-storage';
import { supabase } from '../../config/supabase';

type ActionButton = {
  id: string;
  title: string;
  type: 'reply' | 'mark-read' | 'snooze' | 'custom';
};

type Device = {
  id: string;
  user_id: string;
  device_id: string;
  expo_token: string;
  platform: string;
  last_active: string;
};

export default function RemoteNotificationSender({ userId }: { userId: string }) {
  const [title, setTitle] = useState('');
  const [body, setBody] = useState('');
  const [isSending, setIsSending] = useState(false);
  const [useActionButtons, setUseActionButtons] = useState(false);
  const [scheduleLater, setScheduleLater] = useState(false);
  const [scheduleMinutes, setScheduleMinutes] = useState('30');
  const [customActions, setCustomActions] = useState<ActionButton[]>([
    { id: 'REPLY', title: '💬 Reply', type: 'reply' },
    { id: 'SNOOZE', title: '⏰ Remind later', type: 'snooze' },
    { id: 'LOVE', title: '❤️ Love it', type: 'custom' },
  ]);
  
  const [devices, setDevices] = useState<Device[]>([]);
  const [selectedDevice, setSelectedDevice] = useState<Device | null>(null);
  const [showDeviceModal, setShowDeviceModal] = useState(false);
  const [thisDeviceToken, setThisDeviceToken] = useState<string | null>(null);
  const [manualExpoToken, setManualExpoToken] = useState('');
  const [useManualToken, setUseManualToken] = useState(false);

  const notificationService = NotificationService.getInstance(userId);

  // Load devices on mount
  useEffect(() => {
    loadDevices();
    getThisDeviceToken();
  }, []);

  const getThisDeviceToken = async () => {
    try {
      // Try to get from storage first
      let token = await AsyncStorage.getItem('expoToken');
      
      // If not found, request fresh token (works on Android too)
      if (!token) {
        const { status } = await Notifications.requestPermissionsAsync();
        if (status === 'granted') {
          token = (await Notifications.getExpoPushTokenAsync()).data;
          await AsyncStorage.setItem('expoToken', token);
        }
      }
      
      setThisDeviceToken(token);
    } catch (error) {
      console.error('Failed to get device token:', error);
    }
  };

  const loadDevices = async () => {
    try {
      const { data, error } = await supabase
        .from('push_tokens')
        .select('*')
        .eq('user_id', userId)
        .order('last_active', { ascending: false });

      if (error) throw error;
      setDevices(data || []);
      
      // Select this device by default
      const thisDevice = data?.find(d => d.expo_token === thisDeviceToken);
      if (thisDevice) {
        setSelectedDevice(thisDevice);
      } else if (data && data.length > 0) {
        setSelectedDevice(data[0]);
      }
    } catch (error) {
      console.error('Failed to load devices:', error);
    }
  };

  // Pre-defined action button templates
  const actionTemplates = {
    love: [
      { id: 'REPLY', title: '💬 Reply', type: 'reply' as const },
      { id: 'LOVE', title: '❤️ Love', type: 'custom' as const },
      { id: 'SNOOZE', title: '⏰ Later', type: 'snooze' as const },
      { id: 'HUG', title: '🤗 Hug', type: 'custom' as const },
    ],
    question: [
      { id: 'YES', title: '✅ Yes', type: 'custom' as const },
      { id: 'NO', title: '❌ No', type: 'custom' as const },
      { id: 'MAYBE', title: '🤔 Maybe', type: 'custom' as const },
      { id: 'EXPLAIN', title: '💬 Explain', type: 'reply' as const },
    ],
    reminder: [
      { id: 'DONE', title: '✓ Done', type: 'custom' as const },
      { id: 'REMIND_1H', title: '⏰ In 1 hour', type: 'snooze' as const },
      { id: 'REMIND_3H', title: '⏰ In 3 hours', type: 'snooze' as const },
      { id: 'REMIND_TMRW', title: '📅 Tomorrow', type: 'snooze' as const },
    ],
    mood: [
      { id: 'HAPPY', title: '😊 Happy', type: 'custom' as const },
      { id: 'LOVED', title: '🥰 Loved', type: 'custom' as const },
      { id: 'SAD', title: '😢 Sad', type: 'custom' as const },
      { id: 'TIRED', title: '😴 Tired', type: 'custom' as const },
      { id: 'ENERGETIC', title: '⚡ Energetic', type: 'custom' as const },
    ],
    food: [
      { id: 'BREAKFAST', title: '🍳 Breakfast', type: 'custom' as const },
      { id: 'LUNCH', title: '🥗 Lunch', type: 'custom' as const },
      { id: 'DINNER', title: '🍜 Dinner', type: 'custom' as const },
      { id: 'SNACK', title: '🍎 Snack', type: 'custom' as const },
    ],
    exercise: [
      { id: 'WALK', title: '🚶 Walk', type: 'custom' as const },
      { id: 'RUN', title: '🏃 Run', type: 'custom' as const },
      { id: 'GYM', title: '💪 Gym', type: 'custom' as const },
      { id: 'YOGA', title: '🧘 Yoga', type: 'custom' as const },
    ],
  };

  const sendToDevice = async (expoToken: string) => {
    if (!expoToken) {
      throw new Error('No Expo token provided');
    }

    const actionsPayload = useActionButtons ? {
      category: 'default', // Expo uses this for interactive notifications
      actions: customActions.map((action, index) => ({
        id: action.id,
        title: action.title,
        // For Android compatibility
        buttonTitle: action.title,
      })),
    } : {};

    const response = await fetch('https://exp.host/--/api/v2/push/send', {
      method: 'POST',
      headers: {
        'Accept': 'application/json',
        'Accept-encoding': 'gzip, deflate',
        'Content-Type': 'application/json',
      },
      body: JSON.stringify({
        to: expoToken,
        title,
        body,
        sound: 'default',
        badge: 1,
        data: { 
          type: 'remote', 
          from: userId,
          actions: useActionButtons ? customActions : undefined,
        },
        ...actionsPayload, // Include category/actions for remote interactive support
        // Android specific enhancements
        priority: 'high',
        channelId: 'love_channel',
      }),
    });
    
    const result = await response.json();
    return result;
  };

  const sendCustomNotification = async () => {
    if (!title.trim() || !body.trim()) {
      Alert.alert('Error', 'Please enter both title and body');
      return;
    }

    let targetToken = '';
    
    if (useManualToken && manualExpoToken.trim()) {
      targetToken = manualExpoToken.trim();
    } else if (selectedDevice) {
      targetToken = selectedDevice.expo_token;
    } else {
      Alert.alert('Error', 'Please select a device or enter a manual Expo token');
      return;
    }

    setIsSending(true);
    
    try {
      const result = await sendToDevice(targetToken);
      
      if (result.data?.status === 'ok') {
        Alert.alert('Success', `Notification sent successfully!${useActionButtons ? ' (Actions included)' : ''}`);
        // Clear form
        setTitle('');
        setBody('');
      } else {
        throw new Error(result.errors?.[0]?.message || 'Unknown error');
      }
    } catch (error: any) {
      Alert.alert('Error', `Failed to send: ${error.message}`);
    } finally {
      setIsSending(false);
    }
  };

  const sendScheduledNotification = async () => {
    if (!title.trim() || !body.trim()) {
      Alert.alert('Error', 'Please enter both title and body');
      return;
    }

    const minutes = parseInt(scheduleMinutes);
    if (isNaN(minutes) || minutes < 1 || minutes > 1440) {
      Alert.alert('Error', 'Please enter valid minutes (1-1440)');
      return;
    }

    setIsSending(true);
    
    try {
      // Schedule locally (on current device)
      const trigger = {
        seconds: minutes * 60,
        channelId: 'love_channel', // Android channel
      };

      await Notifications.scheduleNotificationAsync({
        content: {
          title,
          body,
          sound: true,
          data: { 
            type: 'scheduled',
            actions: useActionButtons ? customActions : undefined 
          },
        },
        trigger,
      });
      
      Alert.alert('Scheduled', `Notification will appear in ${minutes} minute(s)`);
      setTitle('');
      setBody('');
      setScheduleLater(false);
    } catch (error) {
      Alert.alert('Error', 'Failed to schedule notification');
    } finally {
      setIsSending(false);
    }
  };

  const applyActionTemplate = (template: keyof typeof actionTemplates) => {
    setCustomActions([...actionTemplates[template]]);
    setUseActionButtons(true);
    Alert.alert('Template Applied', `Action buttons updated to ${template} template`);
  };

  const addCustomAction = () => {
    Alert.prompt(
      'Add Action Button',
      'Enter button title (e.g., "👍 Like")',
      [
        { text: 'Cancel', style: 'cancel' },
        {
          text: 'Add',
          onPress: (buttonTitle) => {
            if (buttonTitle && buttonTitle.trim()) {
              setCustomActions([
                ...customActions,
                {
                  id: `CUSTOM_${Date.now()}`,
                  title: buttonTitle.trim(),
                  type: 'custom',
                },
              ]);
            }
          },
        },
      ]
    );
  };

  const removeAction = (id: string) => {
    setCustomActions(customActions.filter(a => a.id !== id));
  };

  // Quick Templates with rich content
  const quickTemplates = [
    { name: '💕 Love Message', icon: 'heart', color: '#FF6B9D', title: 'Thinking of You 💕', body: 'You crossed my mind and made me smile. Hope you\'re having a beautiful day!', actions: 'love' },
    { name: '🌅 Good Morning', icon: 'sunny', color: '#FFA500', title: 'Good Morning Sunshine! 🌅', body: 'Rise and shine! Today is full of possibilities. I believe in you! 💪', actions: 'love' },
    { name: '🌙 Good Night', icon: 'moon', color: '#483D8B', title: 'Sweet Dreams 🌙', body: 'May your dreams be as sweet as you are. Good night, my love! 💤', actions: 'love' },
    { name: '❓ Daily Question', icon: 'help-circle', color: '#4CAF50', title: '💭 Quick Question', body: 'What\'s one thing that made you smile today?', actions: 'question' },
    { name: '📸 Memory Request', icon: 'camera', color: '#9C27B0', title: 'Share a Memory 📸', body: 'Take a photo of something beautiful today and save it to our memories!', actions: 'reminder' },
    { name: '😊 Mood Check', icon: 'happy', color: '#FF9800', title: 'How are you feeling? 🌈', body: 'Take a moment to check in with yourself. Your feelings matter to me.', actions: 'mood' },
    { name: '🍕 Lunch Time', icon: 'restaurant', color: '#FF5722', title: 'Time to Eat! 🍕', body: 'Don\'t skip lunch! Take a break and nourish your body.', actions: 'food' },
    { name: '💪 Workout', icon: 'fitness', color: '#2196F3', title: 'Time to Move! 💪', body: 'Remember your fitness goals! Even a short walk counts.', actions: 'exercise' },
    { name: '💧 Hydration', icon: 'water', color: '#00BCD4', title: 'Drink Water! 💧', body: 'Stay hydrated, beautiful! Your body will thank you 💕', actions: 'reminder' },
    { name: '🎵 Song Reminder', icon: 'musical-note', color: '#E91E63', title: '🎵 This song reminded me of you!', body: 'Listen to our song - sending you virtual hugs 🤗', actions: 'love' },
    { name: '📝 Note Reminder', icon: 'document-text', color: '#607D8B', title: 'Don\'t forget! 📝', body: 'Just a gentle reminder that I believe in you!', actions: 'reminder' },
    { name: '🎉 Celebration', icon: 'gift', color: '#FF5722', title: 'Celebrate You! 🎉', body: 'You deserve all the happiness in the world!', actions: 'love' },
    { name: '💪 Encouragement', icon: 'fitness', color: '#2196F3', title: 'You\'ve Got This! 💪', body: 'Whatever you\'re facing, I know you can handle it!', actions: 'love' },
    { name: '📖 Read Reminder', icon: 'book', color: '#795548', title: 'Time to Read 📖', body: 'Take 10 minutes for yourself today. You deserve a break!', actions: 'reminder' },
    { name: '🧘 Self Care', icon: 'leaf', color: '#8BC34A', title: 'Self Care Time 🧘', body: 'Remember to take care of yourself today. You matter! 💕', actions: 'mood' },
  ];

  const loadTemplate = (template: typeof quickTemplates[0]) => {
    setTitle(template.title);
    setBody(template.body);
    if (template.actions && actionTemplates[template.actions as keyof typeof actionTemplates]) {
      setCustomActions([...actionTemplates[template.actions as keyof typeof actionTemplates]]);
      setUseActionButtons(true);
    }
  };

  const DeviceSelector = () => (
    <TouchableOpacity style={styles.deviceSelector} onPress={() => setShowDeviceModal(true)}>
      <Icon name="phone-portrait" size={20} color="#FF6B9D" />
      <Text style={styles.deviceSelectorText}>
        {selectedDevice 
          ? `Sending to: \( {selectedDevice.platform || 'Device'} ( \){selectedDevice.device_id?.slice(-8)})`
          : 'No device selected'}
      </Text>
      <Icon name="chevron-down" size={18} color="#FF6B9D" />
    </TouchableOpacity>
  );

  return (
    <ScrollView style={styles.container} showsVerticalScrollIndicator={false}>
      <View style={styles.header}>
        <Icon name="notifications-circle" size={60} color="#FF6B9D" />
        <Text style={styles.title}>📡 Remote Notification Sender</Text>
        <Text style={styles.subtitle}>Send beautiful messages (Android Ready)</Text>
      </View>

      {/* Device Selector + Manual Token */}
      <View style={styles.section}>
        <Text style={styles.sectionTitle}>📱 Target Device</Text>
        
        <View style={styles.switchRow}>
          <Text style={styles.label}>Use Manual Expo Token</Text>
          <Switch
            value={useManualToken}
            onValueChange={setUseManualToken}
            trackColor={{ false: '#ddd', true: '#FF6B9D' }}
            thumbColor="#fff"
          />
        </View>

        {useManualToken ? (
          <View style={styles.inputContainer}>
            <Text style={styles.label}>Expo Push Token</Text>
            <TextInput
              style={styles.input}
              value={manualExpoToken}
              onChangeText={setManualExpoToken}
              placeholder="ExponentPushToken[xxxxxxxxxxxxxxxxxxxxxx]"
              placeholderTextColor="#999"
            />
            <Text style={styles.deviceHint}>Paste full token here for any device</Text>
          </View>
        ) : (
          <>
            <DeviceSelector />
            {thisDeviceToken && (
              <Text
             selectable={true}
              
              style={styles.deviceHint}>This device token: {thisDeviceToken}</Text>
            )}
          </>
        )}
      </View>

      {/* Custom Message Section */}
      <View style={styles.section}>
        <Text style={styles.sectionTitle}>✏️ Custom Message</Text>
        
        <View style={styles.inputContainer}>
          <Text style={styles.label}>Title</Text>
          <TextInput
            style={styles.input}
            value={title}
            onChangeText={setTitle}
            placeholder="e.g., Thinking of You 💕"
            placeholderTextColor="#999"
          />
        </View>

        <View style={styles.inputContainer}>
          <Text style={styles.label}>Message</Text>
          <TextInput
            style={[styles.input, styles.textArea]}
            value={body}
            onChangeText={setBody}
            placeholder="Your message here..."
            placeholderTextColor="#999"
            multiline
            numberOfLines={4}
          />
        </View>

        {/* Action Buttons Toggle - Now works remotely via Expo */}
        <View style={styles.switchRow}>
          <Text style={styles.label}>Add Action Buttons (Remote + Local)</Text>
          <Switch
            value={useActionButtons}
            onValueChange={setUseActionButtons}
            trackColor={{ false: '#ddd', true: '#FF6B9D' }}
            thumbColor="#fff"
          />
        </View>

        {/* Custom Actions Editor */}
        {useActionButtons && (
          <View style={styles.actionsContainer}>
            <Text style={styles.label}>Action Buttons:</Text>
            {customActions.map((action) => (
              <View key={action.id} style={styles.actionItem}>
                <Text style={styles.actionText}>{action.title}</Text>
                <TouchableOpacity onPress={() => removeAction(action.id)}>
                  <Icon name="close-circle" size={20} color="#FF6B9D" />
                </TouchableOpacity>
              </View>
            ))}
            
            <View style={styles.actionButtonsRow}>
              <TouchableOpacity style={styles.addActionButton} onPress={addCustomAction}>
                <Icon name="add-circle" size={20} color="#FF6B9D" />
                <Text style={styles.addActionText}>Add Button</Text>
              </TouchableOpacity>
            </View>
          </View>
        )}

        {/* Schedule Later Toggle */}
        <View style={styles.switchRow}>
          <Text style={styles.label}>Schedule for later (local only)</Text>
          <Switch
            value={scheduleLater}
            onValueChange={setScheduleLater}
            trackColor={{ false: '#ddd', true: '#FF6B9D' }}
            thumbColor="#fff"
          />
        </View>

        {scheduleLater && (
          <View style={styles.scheduleContainer}>
            <Text style={styles.label}>Minutes from now:</Text>
            <TextInput
              style={styles.minutesInput}
              value={scheduleMinutes}
              onChangeText={setScheduleMinutes}
              keyboardType="numeric"
              placeholder="30"
            />
            <Text style={styles.minutesHint}>1-1440 minutes (max 24 hours)</Text>
          </View>
        )}

        <TouchableOpacity 
          style={styles.sendButton} 
          onPress={scheduleLater ? sendScheduledNotification : sendCustomNotification} 
          disabled={isSending}>
          <Icon name={scheduleLater ? "calendar" : "send"} size={20} color="#fff" />
          <Text style={styles.sendButtonText}>
            {isSending ? 'Sending...' : (scheduleLater ? 'Schedule' : 'Send Now')}
          </Text>
        </TouchableOpacity>
      </View>

      {/* Quick Templates Section */}
      <View style={styles.section}>
        <Text style={styles.sectionTitle}>📋 Quick Templates</Text>
        <Text style={styles.sectionSubtitle}>Tap to load and customize</Text>
        
        <View style={styles.templatesGrid}>
          {quickTemplates.map((template, index) => (
            <TouchableOpacity
              key={index}
              style={[styles.templateCard, { borderTopColor: template.color }]}
              onPress={() => loadTemplate(template)}>
              <Icon name={template.icon} size={24} color={template.color} />
              <Text style={styles.templateName}>{template.name}</Text>
            </TouchableOpacity>
          ))}
        </View>
      </View>

      {/* Action Templates Quick Access */}
      <View style={styles.section}>
        <Text style={styles.sectionTitle}>🎯 Action Button Presets</Text>
        <View style={styles.presetRow}>
          {Object.keys(actionTemplates).map((key) => (
            <TouchableOpacity 
              key={key}
              style={styles.presetButton} 
              onPress={() => applyActionTemplate(key as keyof typeof actionTemplates)}>
              <Icon name="ellipse" size={16} color="#FF6B9D" />
              <Text style={styles.presetText}>{key}</Text>
            </TouchableOpacity>
          ))}
        </View>
      </View>

      {/* Device Selection Modal */}
      <Modal visible={showDeviceModal} transparent animationType="slide">
        <View style={styles.modalContainer}>
          <View style={styles.modalContent}>
            <Text style={styles.modalTitle}>Select Target Device</Text>
            <FlatList
              data={devices}
              keyExtractor={(item) => item.id}
              renderItem={({ item }) => (
                <TouchableOpacity
                  style={styles.deviceItem}
                  onPress={() => {
                    setSelectedDevice(item);
                    setShowDeviceModal(false);
                  }}>
                  <Icon name="phone-portrait" size={24} color="#FF6B9D" />
                  <View style={styles.deviceInfo}>
                    <Text style={styles.deviceName}>{item.platform || 'Device'}</Text>
                    <Text style={styles.deviceId}>ID: {item.device_id?.slice(-12)}</Text>
                    <Text style={styles.deviceLast}>
                      Last active: {new Date(item.last_active).toLocaleDateString()}
                    </Text>
                  </View>
                  {selectedDevice?.id === item.id && (
                    <Icon name="checkmark-circle" size={24} color="#4CAF50" />
                  )}
                </TouchableOpacity>
              )}
            />
            <TouchableOpacity style={styles.closeModalButton} onPress={() => setShowDeviceModal(false)}>
              <Text style={styles.closeModalText}>Close</Text>
            </TouchableOpacity>
          </View>
        </View>
      </Modal>
    </ScrollView>
  );
}

