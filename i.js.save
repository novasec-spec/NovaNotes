// ─────────────────────────────────────────────────────────────────────────────
//  app/(tabs)/chat/chatlist.tsx  —  ALL USERS + CHATS
// ─────────────────────────────────────────────────────────────────────────────
//
//  ✅ ALL ORIGINAL LOGIC PRESERVED
//  🆕 NEW: Shows ALL users who have created an account
//  🆕 NEW: Users without chats appear at the bottom with "Tap to start chatting"
//  🆕 NEW: Combined list of chats + all users
//  ✅ All swipe actions, typing indicators, online status preserved
// ─────────────────────────────────────────────────────────────────────────────

// ... [ALL YOUR EXISTING IMPORTS REMAIN THE SAME] ...

export default function ChatList({ user, onSelectUser }: Props) {
  // ... [ALL YOUR EXISTING STATE AND HOOKS REMAIN THE SAME] ...

  // ─── NEW: Combined Data ──────────────────────────────────────────────────
  const combinedList = useMemo(() => {
    // Get users who have chats
    const usersWithChats = new Set(state.map(c => c.other_user.id));
    
    // Get users without chats
    const usersWithoutChats = allUsers.filter(u => !usersWithChats.has(u.id));
    
    // Create chat items for users without chats
    const newChatItems: ChatWithMetadata[] = usersWithoutChats.map(u => ({
      id: `user-${u.id}`, // Temporary ID for display
      user1_id: user.id,
      user2_id: u.id,
      last_message: 'Tap to start chatting 💬',
      last_message_time: u.last_seen || new Date().toISOString(),
      other_user: u,
      unread_count: 0,
      created_at: new Date().toISOString(),
      isMuted: false,
      isArchived: false,
      isPinned: false,
      draft: '',
      verified: false,
    }));

    // Combine: chats first, then new users
    return [...state, ...newChatItems];
  }, [state, allUsers, user.id]);

  // ─── Sorted & Filtered ──────────────────────────────────────────────────
  const sortedChats = useMemo(() => {
    let chats = combinedList.filter(c => !c.isArchived);
    
    // Apply search filter
    if (searchQuery) {
      const query = searchQuery.toLowerCase();
      chats = chats.filter(c => 
        c.other_user.username?.toLowerCase().includes(query) ||
        c.other_user.email?.toLowerCase().includes(query) ||
        c.last_message?.toLowerCase().includes(query)
      );
    }

    // Apply filter mode
    if (filterMode === 'unread') {
      chats = chats.filter(c => c.unread_count > 0);
    }

    // Sort: pinned first, then by last_message_time
    return chats.sort((a, b) => {
      if (a.isPinned && !b.isPinned) return -1;
      if (!a.isPinned && b.isPinned) return 1;
      
      // Users without chats go to bottom
      const aHasChat = state.some(s => s.id === a.id);
      const bHasChat = state.some(s => s.id === b.id);
      if (aHasChat && !bHasChat) return -1;
      if (!aHasChat && bHasChat) return 1;
      
      return new Date(b.last_message_time).getTime() - new Date(a.last_message_time).getTime();
    });
  }, [combinedList, searchQuery, filterMode, state]);

  // ─── Update Render Chat Item ────────────────────────────────────────────
  const renderChatItem = useCallback(({ item }: { item: ChatWithMetadata }) => {
    const isTyping = typingUsers.has(item.other_user.id);
    const unreadCount = item.unread_count || 0;
    const hasDraft = !!item.draft && item.draft.length > 0;
    const isNewUser = item.id.startsWith('user-'); // Identifies users without chats

    const renderRightActions = () => (
      <SwipeActions
        chatId={item.id}
        isArchived={item.isArchived}
        isPinned={item.isPinned}
        isMuted={item.isMuted}
        onAction={handleChatAction}
        colors={colors}
      />
    );

    return (
      <Swipeable
        ref={ref => {
          if (ref) swipeableRefs.current.set(item.id, ref);
        }}
        renderRightActions={isNewUser ? undefined : renderRightActions}
        overshootFriction={8}
        rightThreshold={SWIPE_THRESHOLD}
        onSwipeableWillOpen={() => haptics.light()}
      >
        <ReAnimated.View
          entering={FadeIn.duration(300).delay(50)}
          layout={Layout.springify().damping(20)}
        >
          <TouchableOpacity
            style={[
              styles.userRow, 
              { 
                backgroundColor: colors.card,
                opacity: isNewUser ? 0.85 : 1,
              }
            ]}
            onPress={() => {
              if (unreadCount > 0) handleChatAction('markRead', item.id);
              onSelectUser(item.other_user);
            }}
            onLongPress={() => isNewUser ? null : showContextMenu(item.id)}
            activeOpacity={0.7}
          >
            <Avatar
              uri={item.other_user.avatar_url}
              name={item.other_user.username}
              userId={item.other_user.id}
              online={item.other_user.online}
              verified={item.verified}
            />

            <View style={styles.rowContent}>
              <View style={styles.rowTop}>
                <View style={styles.nameContainer}>
                  <Text style={[styles.userName, { color: colors.text }]} numberOfLines={1}>
                    {item.other_user.username}
                  </Text>
                  {isNewUser && (
                    <View style={styles.newUserBadge}>
                      <Text style={styles.newUserBadgeText}>New</Text>
                    </View>
                  )}
                  {item.isMuted && (
                    <Icon name="volume-mute-outline" size={14} color={colors.muted} style={styles.muteIcon} />
                  )}
                  {item.isPinned && (
                    <Icon name="pin-outline" size={14} color={colors.muted} style={styles.pinIcon} />
                  )}
                </View>
                <Text style={[styles.timeText, { color: colors.muted }]}>
                  {isNewUser ? 'New' : formatMessageTime(item.last_message_time)}
                </Text>
              </View>

              <View style={styles.rowBottom}>
                <View style={styles.previewContainer}>
                  {isTyping ? (
                    <View style={{ flexDirection: 'row', alignItems: 'center', gap: 6 }}>
                      <Text style={[styles.typingText, { color: '#FF6B9D' }]}>typing</Text>
                      <TypingDots color="#FF6B9D" />
                    </View>
                  ) : hasDraft ? (
                    <Text style={[styles.subtleText, { color: '#F59E0B' }]} numberOfLines={1}>
                      <Text style={{ fontWeight: '700' }}>Draft: </Text>
                      {truncateText(item.draft!)}
                    </Text>
                  ) : (
                    <Text style={[
                      styles.subtleText, 
                      { 
                        color: isNewUser ? '#FF6B9D' : colors.muted,
                        fontWeight: isNewUser ? '600' : '400',
                      }
                    ]} numberOfLines={1}>
                      {isNewUser ? '✨ Say hello!' : item.last_message}
                    </Text>
                  )}
                </View>

                {unreadCount > 0 && (
                  <View style={styles.unreadBadge}>
                    <Text style={styles.unreadTxt}>
                      {unreadCount > 99 ? '99+' : unreadCount}
                    </Text>
                  </View>
                )}
              </View>
            </View>
          </TouchableOpacity>
        </ReAnimated.View>
      </Swipeable>
    );
  }, [typingUsers, colors, handleChatAction, onSelectUser, showContextMenu, state]);

  // ─── Update Empty State ─────────────────────────────────────────────────
  // Remove empty state since we now show all users

  // ─── All other functions remain EXACTLY the same ──────────────────────

  // ... [REST OF YOUR CODE REMAINS UNCHANGED] ...

  // ─── Main Render ──────────────────────────────────────────────────────────

  // Skeleton Loading (unchanged)
  if (loading && state.length === 0) {
    // ... [YOUR EXISTING SKELETON CODE] ...
  }

  // Main List - Update to use combinedList
  return (
    <GestureHandlerRootView style={[styles.container, { backgroundColor: colors.background }]}>
      <SafeAreaView style={[styles.container, { backgroundColor: colors.background }]} edges={['top']}>
        <StatusBar barStyle={isDarkMode ? 'light-content' : 'dark-content'} />

        {renderHeader()}

        {/* Chat List - Shows ALL users */}
        <FlatList
          data={Object.entries(groupedChats)}
          keyExtractor={([section]) => section}
          style={styles.list}
          contentContainerStyle={styles.listContent}
          showsVerticalScrollIndicator={false}
          refreshControl={
            <RefreshControl refreshing={refreshing} onRefresh={onRefresh} tintColor="#FF6B9D" colors={['#FF6B9D']} />
          }
          renderItem={({ item: [section, chats] }) => (
            <View>
              <View style={[styles.sectionHeader, { backgroundColor: colors.background }]}>
                <Text style={[styles.sectionHeaderText, { color: colors.muted }]}>{section}</Text>
              </View>
              {chats.map(chat => (
                <View key={chat.id}>
                  {renderChatItem({ item: chat })}
                </View>
              ))}
            </View>
          )}
          ListEmptyComponent={
            <EmptyStateIllustration type="empty" colors={colors} />
          }
        />

        {renderContextMenu()}
      </SafeAreaView>
    </GestureHandlerRootView>
  );
}

// ─── NEW STYLES ──────────────────────────────────────────────────────────────
// Add these to your existing styles

const newStyles = {
  newUserBadge: {
    backgroundColor: '#FF6B9D20',
    paddingHorizontal: 8,
    paddingVertical: 2,
    borderRadius: 10,
    borderWidth: 1,
    borderColor: '#FF6B9D',
  },
  newUserBadgeText: {
    fontSize: 9,
    fontWeight: '700',
    color: '#FF6B9D',
    textTransform: 'uppercase',
  },
};
